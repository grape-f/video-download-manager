# ============================================================
# 在线视频下载管理器 - 环境变量配置
# 复制本文件为 .env 后按需修改
# ============================================================

# 后端服务端口
PORT=8787
# 监听地址（本机使用建议改为 127.0.0.1，避免局域网访问设置页和配对 token）
HOST=0.0.0.0

# 数据目录（SQLite 数据库存放位置，相对于项目根目录）
DATA_DIR=./data
# 下载目录（视频文件保存位置，相对于项目根目录）
DOWNLOAD_DIR=./downloads

# 最大并发下载任务数
MAX_CONCURRENT=3
# 默认下载质量（best / 2160p / 1440p / 1080p / 720p / 480p / 360p，也接受 2k / 4k 别名）
DEFAULT_QUALITY=best
# 默认文件格式（mp4 / webm / mkv）
DEFAULT_FORMAT=mp4

# 最大下载速度（如 8M / 2M，留空表示不限速）
MAX_SPEED=
# 请求超时时间（毫秒）
REQUEST_TIMEOUT_MS=120000
# 自动重试次数
AUTO_RETRIES=3

# yt-dlp 可执行文件路径（默认使用 PATH 中的 yt-dlp）
YTDLP_PATH=yt-dlp
# YouTube 需要的 JavaScript 运行时与 EJS 挑战求解组件
# 留空使用当前运行后端的 Node 可执行文件；设为 none 可关闭（不推荐）
YTDLP_JS_RUNTIME=
# 取值：ejs:github / ejs:npm / none
YTDLP_REMOTE_COMPONENTS=ejs:github
# yt-dlp 登录凭据（仅用于你本人已登录、有权访问的内容）
# 默认自动探测本机浏览器 cookies（Edge / Chrome / Firefox / Brave 等），无需配置
YTDLP_COOKIES_AUTO=true
# 可选：手动指定浏览器（chrome / edge / firefox / brave ...），优先于自动探测
YTDLP_COOKIES_FROM_BROWSER=
# 可选：Netscape 格式 cookies.txt 文件路径（相对项目根目录）；与上一项同时设置时优先使用它
YTDLP_COOKIES=
# ffmpeg 目录（包含 ffmpeg/ffmpeg.exe，用于高清音视频合并）
FFMPEG_PATH=./bin/ffmpeg

# 是否启用模拟下载源（sim:// 协议，用于离线测试；生产环境建议 false）
ENABLE_SIMULATE=true
